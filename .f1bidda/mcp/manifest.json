{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "f1bidda-mcp",
      "version": "0.1.0",
      "title": "f1Bidda F1 MCP"
    },
    "tools": [
      {
        "name": "list_seasons",
        "title": "List seasons",
        "description": "List F1 seasons available in f1Bidda.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_drivers",
        "title": "List drivers",
        "description": "List drivers in the latest OpenF1 session with team, car number, and team color.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_races",
        "title": "List races",
        "description": "List all races in a given F1 season (Jolpica/Ergast).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "season": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Season year, e.g. 2025 or 2026."
            }
          },
          "required": ["season"]
        },
        "outputSchema": null
      },
      {
        "name": "get_race",
        "title": "Get race",
